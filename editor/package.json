{
  "name": "deckhand-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Deckhand config editor (Electron). A config producer only: it writes config.json and talks to the daemon's socket.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "check:shared": "npm run build && node scripts/check-shared-imports.mjs",
    "check:bridge": "npm run build && node scripts/check-bridge.mjs",
    "check:live": "npm run build && node scripts/check-live.mjs",
    "check:hotkey": "npm run build && node scripts/check-hotkey.mjs",
    "check:icons": "npm run build && node scripts/check-icons.mjs",
    "check:panes": "npm run build && node scripts/check-panes.mjs",
    "check:structure": "npm run build && node scripts/check-structure.mjs",
    "check:navigate": "npm run build && node scripts/check-navigate.mjs",
    "test": "node scripts/run-tests.mjs",
    "check:bulk": "npm run build && node scripts/check-bulk.mjs",
    "check:forms": "npm run build && node scripts/check-forms.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
