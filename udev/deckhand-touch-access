#!/bin/bash
#
# Deckhand's touchscreen access. Run as root through pkexec by the editor, and
# only for these two things:
#
#   pair           Gives the user who ran pkexec temporary read access to every
#                  touchscreen they cannot read yet, so the daemon can see which
#                  one is tapped, and prints "granted". Then reads one line:
#                  "set <entries>" writes the rule file (below), drops the
#                  temporary access and prints "done"; anything else, the end
#                  of input, or 5 minutes, drops it and prints "cancelled".
#   set <entries>  Writes the user's rule file to exactly these entries, gives
#                  the user read access to the touchscreens they cover now, and
#                  takes it away from every other touchscreen.
#
# An entry is <vendor>:<product> or <vendor>:<product>:<serial> — a paired
# touchscreen's input IDs (four hex digits each) and its serial when it has one.
#
# WHY IT IS THIS NARROW. Wayland keeps programs from reading each other's
# input; a udev rule that gives the user access to a touchscreen opts that
# device out of the protection, so any program the user runs could read its
# touches — on a touchscreen laptop, what is typed on its on-screen keyboard.
# So Deckhand gives access only to touchscreens paired as virtual decks, never
# to any other, and only from the moment of pairing (Ryan's decision,
# 2026-10-17; SECURITY.md, "Device access"). Do not widen the rule to all
# touchscreens, or add one at install.
#
# WHY A FILE ACL AND NOT THE UACCESS TAG. udev keeps a device's tags until the
# device is unplugged or the machine restarts, and its seat rule re-applies
# uaccess access on every re-trigger of a device that ever had the tag — so a
# touchscreen once granted that way could not be taken back until then
# (measured on the laptop, 2026-10-17). The rule instead runs setfacl for the
# user who paired it, on that device only; removing it is deleting the rule
# and the ACL, with no re-trigger, and nothing brings it back (measured: change
# and add events on the panel, the laptop's own touchscreen and every other).
# The cost: access belongs to the user who paired the touchscreen, whoever is
# logged in at the seat. Read access only: writing to an input device can
# inject events into it.
#
# The script is installed root-owned at /usr/local/libexec, outside anything
# the user can write: pkexec runs it as root, so a copy the user could edit
# would be a way to root. It takes no paths and no user from its caller.

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

RULES_DIR=/etc/udev/rules.d
INPUT=/sys/class/input
DEV=/dev/input
UDEVADM=udevadm
SETFACL=setfacl
GETFACL=getfacl
DEADLINE=300
# Tests only, never as root: scratch paths and stand-ins for udevadm and the ACL tools.
if [ "$(id -u)" != 0 ] && [ -n "${DECKHAND_TOUCH_ACCESS_TEST:-}" ]; then
  RULES_DIR="$DECKHAND_TOUCH_ACCESS_TEST/rules"
  INPUT="$DECKHAND_TOUCH_ACCESS_TEST/sys/class/input"
  DEV="$DECKHAND_TOUCH_ACCESS_TEST/dev/input"
  UDEVADM="$DECKHAND_TOUCH_ACCESS_TEST/bin/udevadm"
  SETFACL="$DECKHAND_TOUCH_ACCESS_TEST/bin/setfacl"
  GETFACL="$DECKHAND_TOUCH_ACCESS_TEST/bin/getfacl"
  DEADLINE="${DECKHAND_TOUCH_ACCESS_DEADLINE:-$DEADLINE}"
fi

die() { echo "error: $*"; exit 1; }

user="${PKEXEC_UID:-}"
[[ "$user" =~ ^[0-9]+$ ]] && [ "$user" != 0 ] || die "run through pkexec, as the user who will use the touchscreen"
# One file per user: the rule names the user, and one user's change must not touch another's.
RULES="$RULES_DIR/61-deckhand-touchscreens-$user.rules"
# The rule runs setfacl by its absolute path.
SETFACL_PATH="$(command -v "$SETFACL")" || die "setfacl is not installed (the acl package)"

# Every touchscreen udev knows of, as event node names.
touchscreens() {
  local node
  for node in "$INPUT"/event*; do
    [ -e "$node" ] || continue
    node="${node##*/}"
    "$UDEVADM" info -q property -n "$DEV/$node" 2>/dev/null | grep -qx 'ID_INPUT_TOUCHSCREEN=1' && echo "$node"
  done
}

has_access() { "$GETFACL" -n -c -p "$DEV/$1" 2>/dev/null | grep -q "^user:$user:r"; }

# The rule for each entry: read access for this user, by a file ACL, when the
# touchscreen appears (at boot, or plugged in). Never the uaccess tag (above).
# A serial is matched as the USB device's serial or the input device's uniq,
# whichever the touchscreen has; never left out, so an entry with one covers
# that one touchscreen.
rule_lines() {
  local entry vendor product serial base grant
  grant="RUN+=\"$SETFACL_PATH -m u:$user:r \$devnode\""
  for entry in "$@"; do
    IFS=: read -r vendor product serial <<<"$entry"
    base="SUBSYSTEM==\"input\", KERNEL==\"event*\", ENV{ID_INPUT_TOUCHSCREEN}==\"1\", ATTRS{id/vendor}==\"$vendor\", ATTRS{id/product}==\"$product\""
    if [ -z "$serial" ]; then
      echo "$base, $grant"
    else
      echo "$base, ATTRS{uniq}==\"$serial\", $grant"
      echo "$base, ENV{ID_SERIAL_SHORT}==\"$serial\", $grant"
    fi
  done
}

# Whether a touchscreen node is the one an entry names: as the rule matches.
covers() {
  local node="$1" entry="$2" vendor product serial dir
  IFS=: read -r vendor product serial <<<"$entry"
  dir="$INPUT/$node/device"
  [ "$(cat "$dir/id/vendor" 2>/dev/null)" = "$vendor" ] && [ "$(cat "$dir/id/product" 2>/dev/null)" = "$product" ] || return 1
  [ -z "$serial" ] && return 0
  [ "$(cat "$dir/uniq" 2>/dev/null)" = "$serial" ] && return 0
  "$UDEVADM" info -q property -n "$DEV/$node" 2>/dev/null | grep -qx "ID_SERIAL_SHORT=$serial"
}

# Strict: four hex digits each, and a serial of letters, digits, ".", "_" and
# "-" — nothing udev would read as a pattern or a quote. At most 32 entries.
check_entries() {
  [ $# -le 32 ] || die "too many touchscreens"
  local entry
  for entry in "$@"; do
    [[ "$entry" =~ ^[0-9a-f]{4}:[0-9a-f]{4}(:[A-Za-z0-9._-]{1,64})?$ ]] || die "not a touchscreen entry: $entry"
  done
}

write_rules() {
  local tmp
  mkdir -p "$(dirname "$RULES")"
  if [ $# -eq 0 ]; then
    rm -f "$RULES"
  else
    tmp="$(mktemp "$RULES.XXXXXX")"
    {
      echo "# Written by Deckhand when a touchscreen is paired as a virtual deck, for user"
      echo "# $user: one entry per touchscreen they paired, and nothing else. Any program"
      echo "# that user runs can read a touchscreen this covers, so it covers only those."
      echo "# A file ACL, never the uaccess tag, so a removed entry stays removed. See"
      echo "# /usr/local/libexec/deckhand-touch-access. Removed by deckhand-uninstall."
      rule_lines "$@"
    } > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$RULES"
  fi
  "$UDEVADM" control --reload
}

# Access now, as the rules give it at the next plug-in: read for the user on
# every touchscreen an entry covers, none on any other. Directly, with no
# re-trigger: nothing else is touched, and no other user's access.
apply_now() {
  local node entry covered
  for node in $(touchscreens); do
    covered=no
    for entry in "$@"; do covers "$node" "$entry" && covered=yes && break; done
    if [ "$covered" = yes ]; then "$SETFACL" -m "u:$user:r" "$DEV/$node"
    else "$SETFACL" -x "u:$user" "$DEV/$node" 2>/dev/null || true; fi
  done
}

granted=()
drop_temporary() {
  local node
  for node in "${granted[@]}"; do "$SETFACL" -x "u:$user" "$DEV/$node" 2>/dev/null || true; done
  granted=()
}

case "${1:-}" in
  set)
    shift
    check_entries "$@"
    write_rules "$@"
    apply_now "$@"
    echo done
    ;;
  pair)
    trap 'drop_temporary' EXIT
    trap 'drop_temporary; exit 1' INT TERM HUP
    for node in $(touchscreens); do
      has_access "$node" && continue
      "$SETFACL" -m "u:$user:r" "$DEV/$node"
      granted+=("$node")
    done
    echo granted
    line=""
    if read -r -t "$DEADLINE" line && [[ "$line" == set* ]]; then
      read -r -a words <<<"$line"
      entries=("${words[@]:1}")
      check_entries "${entries[@]}"
      drop_temporary
      write_rules "${entries[@]}"
      apply_now "${entries[@]}"
      echo done
    else
      drop_temporary
      echo cancelled
    fi
    ;;
  *)
    die "usage: deckhand-touch-access pair | set <vendor:product[:serial]>..."
    ;;
esac
