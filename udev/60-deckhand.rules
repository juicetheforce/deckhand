# Elgato Stream Deck — grant the logged-in user access to the HID device.
# uaccess hands access to whoever owns the active seat, which is safer than
# a blanket 0666 and survives reboots without a plugdev group.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fd9", TAG+="uaccess"

# /dev/uinput for the key-injection helper.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"

# No touchscreen here. A touchscreen is granted only when it is paired as a
# virtual deck, by a rule of its own in 61-deckhand-touchscreens.rules
# (written by /usr/local/libexec/deckhand-touch-access, which says why): a rule
# granting every touchscreen would let any of the user's programs read every
# touchscreen's touches, a laptop's on-screen keyboard included.
