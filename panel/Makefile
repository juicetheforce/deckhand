CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra
# libwayland-client's headers and library where every distribution puts them,
# so the build needs no pkg-config.
WAYLAND_CFLAGS ?=
WAYLAND_LIBS ?= -lwayland-client

# The protocols' code is generated by wayland-scanner from protocol/*.xml and
# committed, so a build needs only libwayland-client. To regenerate:
#   make protocols
SOURCES := panel.c wayland.c protocol/xdg-shell.c protocol/xdg-output-unstable-v1.c protocol/wlr-layer-shell-unstable-v1.c

deckhand-panel: $(SOURCES) platform.h
	$(CC) $(CFLAGS) $(WAYLAND_CFLAGS) -o $@ $(SOURCES) $(WAYLAND_LIBS)

protocols:
	for p in xdg-shell xdg-output-unstable-v1 wlr-layer-shell-unstable-v1; do \
	  wayland-scanner client-header protocol/$$p.xml protocol/$$p-client.h && \
	  wayland-scanner private-code protocol/$$p.xml protocol/$$p.c; \
	done

clean:
	rm -f deckhand-panel

.PHONY: clean protocols
